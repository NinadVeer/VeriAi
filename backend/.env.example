# ─────────────────────────────────────────────────────────────
# VeriAI Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# CORS — set to your frontend origin (e.g. http://localhost:5500)
CORS_ORIGIN=http://localhost:5500

# ── Firebase Admin SDK ────────────────────────────────────────
# Path to your Firebase service account JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ── Supabase ──────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Use the SERVICE ROLE key (not anon key) — this is server-side only
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Rate Limiting ─────────────────────────────────────────────
# Max requests per window per IP on /api/analyze routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
